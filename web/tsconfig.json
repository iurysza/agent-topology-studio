{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2024", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "allowJs": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "../shared"]
}
