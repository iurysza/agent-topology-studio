  "C:FsError": {
    "message": "",
    "tag": "FsError",
    "isError": true,
    "json": "{\"op\":\"read\",\"path\":\"/x/y\",\"cause\":{},\"_tag\":\"FsError\"}",
    "keys": [
      "op",
      "path",
      "_tag"
    ]
  },
  "C:Problems": {
    "message": "first\nsecond",
    "tag": "Problems",
    "isError": true,
    "json": "{\"problems\":[\"first\",\"second\"],\"warnings\":[\"careful\"],\"_tag\":\"Problems\"}",
    "keys": [
      "problems",
      "warnings",
      "_tag"
    ]
  },
  "C:ProjectPathError": {
    "message": "Workflow and role paths must stay inside the project",
    "tag": "ProjectPathError",
    "isError": true,
    "json": "{\"_tag\":\"ProjectPathError\"}",
    "keys": [
      "_tag"
    ]
  },
  "C:RequestError": {
    "message": "Bad request",
    "tag": "RequestError",
    "isError": true,
    "json": "{\"status\":400,\"message\":\"Bad request\",\"_tag\":\"RequestError\"}",
    "keys": [
      "status",
      "_tag"
    ]
  },
  "C:RoleError": {
    "message": "Role not found: x",
    "tag": "RoleError",
    "isError": true,
    "json": "{\"message\":\"Role not found: x\",\"_tag\":\"RoleError\"}",
    "keys": [
      "_tag"
    ]
  },
  "C:RunIdError": {
    "message": "Invalid run id",
    "tag": "RunIdError",
    "isError": true,
    "json": "{\"message\":\"Invalid run id\",\"_tag\":\"RunIdError\"}",
    "keys": [
      "_tag"
    ]
  },
  "C:StaleError": {
    "message": "The file changed on disk since it was loaded. Reload before saving.",
    "tag": "StaleError",
    "isError": true,
    "json": "{\"baseSha256\":\"aaa\",\"currentSha256\":null,\"_tag\":\"StaleError\"}",
    "keys": [
      "baseSha256",
      "currentSha256",
      "_tag"
    ]
  },
